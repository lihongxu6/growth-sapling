/* 引导教练层：聚光灯 + 松鼠气泡 */
.coach-root {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 60;
}

/* 遮罩：透明，仅用于挡背景交互 + 禁滚（暗化由 target-spot 的 box-shadow 完成） */
.coach-mask {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: transparent;
}

/* 聚光灯：绿环 + 巨大暗影；暗影不计入命中区，故真实步需 pointer-events:auto */
.target-spot {
  position: absolute;
  z-index: 2;
  box-sizing: border-box;
  border-radius: 16rpx;
  pointer-events: none;
  box-shadow:
    0 0 0 4rpx rgba(92, 184, 92, 0.75),
    0 0 0 9999rpx rgba(0, 0, 0, 0.45);
}
.target-spot.real {
  pointer-events: auto;
}

/* 气泡卡 */
.bubble {
  position: absolute;
  z-index: 3;
  pointer-events: auto;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 20rpx 20rpx 16rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.18);
}

.bubble-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  margin-bottom: 8rpx;
}
.bubble-prog {
  font-size: 22rpx;
  font-weight: 700;
  color: #5cb85c;
}
/* 小 ×：22×22 透明灰圆，悬停加深（真机无 hover，保留语义更小更弱） */
.bubble-close {
  width: 44rpx;
  height: 44rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 1;
  color: #999;
  background: transparent;
  border-radius: 50%;
}
.bubble-close:active { background: rgba(0, 0, 0, 0.06); color: #666; }

.bubble-body {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}
.bubble-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.bubble-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.5;
  color: #3a3a3a;
}

.bubble-foot {
  margin-top: 14rpx;
}
.btn-next,
.btn-complete {
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  background: #5cb85c;
}
.btn-next:active,
.btn-complete:active { background: #4ca64c; }
.btn-next.disabled { background: #cfcfcf; color: #fff; }
.btn-next.disabled:active { background: #cfcfcf; }

/* 小尾巴指向目标 */
.bubble-tail {
  position: absolute;
  left: 50%;
  width: 0; height: 0;
  border: 16rpx solid transparent;
  transform: translateX(-50%);
}
.bubble.below .bubble-tail {
  top: -28rpx;
  border-bottom-color: #ffffff;
}
.bubble.above .bubble-tail {
  bottom: -28rpx;
  border-top-color: #ffffff;
}
