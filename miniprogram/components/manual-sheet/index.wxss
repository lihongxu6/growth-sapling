/* 操作手册弹层（G7） */
.manual-root {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 70;
}

.sheet-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
}

.manual-sheet {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  z-index: 75;
  background: #fffaf3;
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 28rpx 40rpx;
  max-height: 82vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #3a3a3a;
}
.sheet-close {
  width: 44rpx; height: 44rpx;
  display: inline-flex; align-items: center; justify-content: center;
  font-size: 28rpx; color: #999; border-radius: 50%;
}
.sheet-close:active { background: rgba(0,0,0,0.06); color: #666; }

.sheet-cards {
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.manual-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: #ffffff;
  border: 2rpx solid #efddc8;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
}
.card-icon { font-size: 48rpx; flex-shrink: 0; }
.card-text { display: flex; flex-direction: column; }
.card-title { font-size: 30rpx; font-weight: 700; color: #3a3a3a; }
.card-desc { font-size: 24rpx; color: #8a8178; margin-top: 4rpx; line-height: 1.45; }

.manual-restart {
  margin-top: 22rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  background: #5cb85c;
}
.manual-restart:active { background: #4ca64c; }
